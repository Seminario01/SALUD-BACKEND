DATABASE_URL=mysql+pymysql://usuario:password@localhost/salud_db
# Login Unico: <URL_DEL_DIA>/realms/rsd (cambia cada dia; para la replica local: http://localhost:8081/realms/rsd)
AUTH_ISSUER=http://localhost:8081/realms/rsd
AUTH_AUDIENCE=rsd-api
MODULOS_API_KEY=
# URLs de los otros modulos (ver docs/INTEGRACIONES.md).
# Para desarrollo con los simuladores (python simuladores/app.py): http://localhost:5055
URL_EDUCACION=http://localhost:5055
URL_SEGURIDAD=http://localhost:5055
# Tributario es un servidor real aparte: URL_TRIBUTARIO debe ser su URL BASE,
# sin ruta (ej. https://tributario.150-136-174-108.nip.io). Para desarrollo
# local con el simulador, usar http://localhost:5055 como los demas.
URL_TRIBUTARIO=http://localhost:5055
TRIBUTARIO_API_KEY=
TRIBUTARIO_PLAZO_VENCIMIENTO_DIAS=15
COSTO_CONSULTA=150

# Origenes del frontend (Vite en 4200, el puerto registrado en el Login Unico)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173

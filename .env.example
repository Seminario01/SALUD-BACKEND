DATABASE_URL=mysql+pymysql://usuario:password@localhost/salud_db
# Login Unico: <URL_DEL_DIA>/realms/rsd (cambia cada dia; para la replica local: http://localhost:8081/realms/rsd)
AUTH_ISSUER=http://localhost:8081/realms/rsd
AUTH_AUDIENCE=rsd-api
MODULOS_API_KEY=
# URLs de los otros modulos (ver docs/INTEGRACIONES.md).
# Para desarrollo con los simuladores (python simuladores/app.py): http://localhost:5055
URL_EDUCACION=http://localhost:5055
URL_SEGURIDAD=http://localhost:5055
URL_TRIBUTARIO=http://localhost:5055
COSTO_CONSULTA=150

# Origenes del frontend (Vite en 4200, el puerto registrado en el Login Unico)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173

# Clave para LLAMAR a cada módulo (la que cada grupo nos da). Vacía = MODULOS_API_KEY
API_KEY_EDUCACION=
API_KEY_SEGURIDAD=
API_KEY_TRIBUTARIO=
# Reenviar el token del usuario a otros módulos. "false" mientras cada módulo use su propio Keycloak
REENVIAR_TOKEN_USUARIO=true

# Clave que Salud ENTREGA a cada módulo para que nos consuma (una por grupo).
# Generar con: openssl rand -hex 32   y enviarla al grupo por mensaje privado.
CLAVE_ENTRADA_SEGURIDAD=
CLAVE_ENTRADA_EDUCACION=
CLAVE_ENTRADA_TRIBUTARIO=
CLAVE_ENTRADA_AUDITORIA=

# Departamento del que se muestran las alertas de Seguridad en el panel
DEPARTAMENTO_ALERTAS=Sacatepéquez
# Tributario: días para el vencimiento de los cobros
DIAS_VENCIMIENTO_COBRO=15

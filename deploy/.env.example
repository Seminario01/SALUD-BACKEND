# Copiar a .env y completar. El .env NUNCA se sube a GitHub.
# Usen contraseñas solo con letras y números (van dentro de una URL).

MYSQL_ROOT_PASSWORD=cambiar_root_123
MYSQL_PASSWORD=cambiar_salud_123

# Login Único: <URL_DEL_DIA>/realms/rsd (la URL la comparte la ingeniera)
AUTH_ISSUER=https://URL-DEL-DIA.trycloudflare.com/realms/rsd

# Clave para los endpoints entre módulos (X-API-Key). Solo servidor a servidor.
MODULOS_API_KEY=cambiar_clave_larga

# Puerto local al que apunta el túnel de Cloudflare (ingress de cloudflared)
PUERTO_WEB=8080

# URLs de los otros módulos (cuando las tengan)
URL_EDUCACION=
URL_SEGURIDAD=
URL_TRIBUTARIO=
